name = "svelte-memo-app-dev"
main = ".svelte-kit/cloudflare/_worker.js"
compatibility_flags = [ "nodejs_compat" ]
compatibility_date = "2024-09-23"

[assets]
directory = ".svelte-kit/cloudflare"
binding = "BUILD"

[[d1_databases]]
binding = "DB"
database_name = "svelte-memo-app-localdb"
database_id = "0000"
migrations_dir = "./src/lib/server/db/migrations"

[env.staging]
name = "svelte-memo-app-stag"
workers_dev = true

[env.staging.observability]
enabled = true

[[env.staging.d1_databases]]
binding = "DB"
database_name = "svelte-memo-app-stagdb"
database_id = "enter_your_db_id"
migrations_dir = "./src/lib/server/db/migrations"
